{
  "name": "sysml2-mermaid",
  "version": "0.1.1",
  "description": "Render SysML v2 textual models (.sysml) as diagrams — a Mermaid plugin, CLI (sysml2svg), Language Server and VS Code extension.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fengdonglu/sysml2-mermaid"
  },
  "keywords": [
    "mermaid",
    "sysml",
    "sysml-v2",
    "sysml2",
    "kerml",
    "uml",
    "mbse",
    "diagram",
    "bdd",
    "block-definition-diagram",
    "requirement-diagram",
    "internal-block-diagram",
    "state-machine",
    "activity-diagram",
    "cli",
    "lsp",
    "language-server",
    "vscode"
  ],
  "bin": {
    "sysml2svg": "./dist/cli/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": "./dist/sysml2-mermaid.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "dev": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "gallery": "npm run build && node scripts/build-gallery.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "elkjs": "^0.9.3"
  },
  "peerDependencies": {
    "mermaid": ">=11"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "mermaid": "^12.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
