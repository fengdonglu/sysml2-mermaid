{
  "name": "sysml2-mermaid-vscode",
  "version": "0.1.0",
  "publisher": "fengdonglu",
  "description": "VS Code support for SysML v2 textual notation — syntax highlighting, diagnostics, preview",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/fengdonglu/sysml2-mermaid", "directory": "packages/vscode-sysml" },
  "license": "MIT",
  "engines": { "vscode": "^1.94.0" },
  "categories": ["Programming Languages", "Visualization"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:sysml"],
  "contributes": {
    "languages": [{ "id": "sysml", "aliases": ["SysML v2"], "extensions": [".sysml"] }],
    "grammars": [{ "language": "sysml", "scopeName": "source.sysml", "path": "./syntaxes/sysml.tmLanguage.json" }],
    "commands": [
      { "command": "sysml.preview", "title": "SysML: Open Preview" },
      { "command": "sysml.exportSvg", "title": "SysML: Export SVG" }
    ],
    "configuration": {
      "title": "sysml2-mermaid",
      "properties": {
        "sysml.diagnostics.enable": { "type": "boolean", "default": true, "description": "Enable SysML diagnostics." },
        "sysml.preview.view": {
          "type": "string",
          "default": "",
          "enum": ["", "bdd", "requirement", "ibd", "statemachine", "activity"],
          "enumDescriptions": ["", "Block Definition Diagram", "Requirement diagram", "Internal Block Diagram", "State machine", "Activity / Swimlane"],
          "description": "View used by 'SysML: Open Preview'. Empty follows the model's view / first-line directive."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "package:vsix": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "sysml2-mermaid": "file:../..",
    "vscode-languageclient": "^9.0.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.94.0"
  }
}
